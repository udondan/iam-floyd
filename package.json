{
  "scripts": {
    "pregenerate": "find lib bin -name \"*.js\" -type f -exec rm -vf {} \\;",
    "generate": "bunx ts-node bin/generate.ts",
    "preemit": "find lib/generator bin -name \"*.js\" -type f -exec rm -vf {} \\;",
    "emit": "bunx ts-node bin/emit.ts",
    "cdk-refs": "bunx ts-node bin/cdk-refs.ts",
    "index-managed-policies": "bunx ts-node bin/index-managed-policies.ts",
    "index-service-principals": "bunx ts-node bin/index-service-principals.ts",
    "build": "bunx tsc --build --force --verbose tsconfig.main.json tsconfig.types.json"
  },
  "name": "iam-floyd",
  "description": "AWS IAM policy statement generator with fluent interface",
  "version": "0.855.0",
  "license": "Apache-2.0",
  "author": {
    "name": "Daniel Schroeder",
    "url": "https://www.udondan.com/"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/udondan"
    }
  ],
  "homepage": "https://github.com/udondan/iam-floyd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/udondan/iam-floyd.git"
  },
  "bugs": {
    "url": "https://github.com/udondan/iam-floyd/issues"
  },
  "keywords": [
    "aws",
    "iam",
    "policy",
    "iam-floyd"
  ],
  "stability": "experimental",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
