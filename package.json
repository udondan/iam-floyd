    "@aws-sdk/client-iam": "3.1176.0",
    "@aws-sdk/client-s3": "3.1176.0",
    "@aws-sdk/client-sqs": "3.1176.0",
    "@eslint/js": "10.0.1",
    "@jsii/spec": "1.143.0",
    "@swc/core": "1.16.22",
    "@swc/helpers": "0.5.24",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "aws-cdk-lib": "2.278.0",
    "c8": "12.0.0",
    "cheerio": "1.2.0",
    "colors": "1.4.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "glob": "14.0.6",
    "globals": "17.14.0",
    "jsii-docgen": "10.13.6",
    "jsii-pacmak": "1.143.0",
    "markdownlint-cli2": "0.24.2",
    "prettier": "3.10.1",
    "regenerator-runtime": "0.14.1",
