    },
    {
      "key": "ecr-public:ResourceTag/${TagKey}",
      "methodName": "ifResourceTag",
      "description": "Filters actions based on tag-value associated with the resource",
      "url": "https://docs.aws.amazon.com/AmazonECR/latest/userguide/security_iam_service-with-iam.html#security_iam_service-with-iam-id-based-policies-conditionkeys",
