      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/greengrass/v2/APIReference/API_DeleteCoreDevice.html"
    },
    {
      "name": "DeleteDeployment",
      "methodName": "toDeleteDeployment",
