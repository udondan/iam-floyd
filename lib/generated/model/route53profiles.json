      "conditionMethods": [
        "ifAwsRequestTag",
        "ifAwsTagKeys",
        "ifResourceIds"
      ]
    },
    {
      "name": "AssociateResourceToProfile",
      "methodName": "toAssociateResourceToProfile",
      "description": "Grants permission to associates a resource, such as DNS Firewall rule group, private hosted zone, resolver rule, etc. to a specified Profile",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/Route53/latest/APIReference/API_route53profiles_AssociateResourceToProfile.html",
      "conditionMethods": [
        "ifFirewallRuleGroupPriority",
        "ifHostedZoneDomains",
        "ifResolverRuleDomains",
        "ifResourceArns",
        "ifResourceTypes"
      ]
    },
    {
