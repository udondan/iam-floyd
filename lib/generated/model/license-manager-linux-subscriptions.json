      "methodName": "toUntagResource",
      "description": "Grants permission to untag a selected resource",
      "accessLevel": "Tagging, Write",
      "url": "https://docs.aws.amazon.com/license-manager-linux-subscriptions/latest/APIReference/API_UntagResource.html"
