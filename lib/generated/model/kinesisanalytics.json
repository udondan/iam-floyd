{
  "schemaVersion": 1,
  "filename": "kinesisanalytics",
  "className": "Kinesisanalytics",
  "name": "kinesisanalytics",
  "servicePrefix": "kinesisanalytics",
  "url": "https://docs.aws.amazon.com/service-authorization/latest/reference/list_kinesisanalytics.html",
  "accessLevelList": {
    "Write": [
      "AddApplicationInput",
      "AddApplicationOutput",
      "AddApplicationReferenceDataSource",
      "CreateApplication",
      "DeleteApplication",
      "DeleteApplicationOutput",
      "DeleteApplicationReferenceDataSource",
      "StartApplication",
      "StopApplication",
      "TagResource",
      "UntagResource",
      "UpdateApplication"
    ],
    "Read": [
      "DescribeApplication",
      "DiscoverInputSchema",
      "ListTagsForResource",
      "GetApplicationState"
    ],
    "List": [
      "ListApplications"
    ],
    "Tagging": [
      "TagResource",
      "UntagResource"
    ]
  },
  "actions": [
    {
      "name": "AddApplicationInput",
      "methodName": "toAddApplicationInput",
      "description": "Grants permission to add input to the application",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/kinesisanalytics/latest/dev/API_AddApplicationInput.html"
    },
    {
      "name": "AddApplicationOutput",
      "methodName": "toAddApplicationOutput",
      "description": "Grants permission to add output to the application",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/kinesisanalytics/latest/dev/API_AddApplicationOutput.html"
    },
    {
      "name": "AddApplicationReferenceDataSource",
      "methodName": "toAddApplicationReferenceDataSource",
      "description": "Grants permission to add reference data source to the application",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/kinesisanalytics/latest/dev/API_AddApplicationReferenceDataSource.html"
    },
    {
      "name": "CreateApplication",
      "methodName": "toCreateApplication",
      "description": "Grants permission to create an application",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/kinesisanalytics/latest/dev/API_CreateApplication.html",
      "conditionMethods": [
        "ifAwsRequestTag",
        "ifAwsTagKeys"
      ]
    },
    {
      "name": "DeleteApplication",
      "methodName": "toDeleteApplication",
      "description": "Grants permission to delete the application",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/kinesisanalytics/latest/dev/API_DeleteApplication.html"
    },
    {
      "name": "DeleteApplicationOutput",
      "methodName": "toDeleteApplicationOutput",
      "description": "Grants permission to delete the specified output of the application",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/kinesisanalytics/latest/dev/API_DeleteApplicationOutput.html"
    },
    {
      "name": "DeleteApplicationReferenceDataSource",
      "methodName": "toDeleteApplicationReferenceDataSource",
      "description": "Grants permission to delete the specified reference data source of the application",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/kinesisanalytics/latest/dev/API_DeleteApplicationReferenceDataSource.html"
    },
    {
      "name": "DescribeApplication",
      "methodName": "toDescribeApplication",
      "description": "Grants permission to describe the specified application",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/kinesisanalytics/latest/dev/API_DescribeApplication.html"
    },
    {
      "name": "DiscoverInputSchema",
      "methodName": "toDiscoverInputSchema",
      "description": "Grants permission to discover the input schema for the application",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/kinesisanalytics/latest/dev/API_DiscoverInputSchema.html"
    },
    {
      "name": "ListApplications",
      "methodName": "toListApplications",
      "description": "Grants permission to list applications for the account",
      "accessLevel": "List",
      "url": "https://docs.aws.amazon.com/kinesisanalytics/latest/dev/API_ListApplications.html"
    },
    {
      "name": "ListTagsForResource",
      "methodName": "toListTagsForResource",
      "description": "Grants permission to fetch the tags associated with the application",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/kinesisanalytics/latest/dev/API_ListTagsForResource.html"
    },
    {
      "name": "StartApplication",
      "methodName": "toStartApplication",
      "description": "Grants permission to start the application",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/kinesisanalytics/latest/dev/API_StartApplication.html"
    },
    {
      "name": "StopApplication",
      "methodName": "toStopApplication",
      "description": "Grants permission to stop the application",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/kinesisanalytics/latest/dev/API_StopApplication.html"
    },
    {
      "name": "TagResource",
      "methodName": "toTagResource",
      "description": "Grants permission to add tags to the application",
      "accessLevel": "Tagging, Write",
      "url": "https://docs.aws.amazon.com/kinesisanalytics/latest/dev/API_TagResource.html"
    },
    {
      "name": "UntagResource",
      "methodName": "toUntagResource",
      "description": "Grants permission to remove the specified tags from the application",
      "accessLevel": "Tagging, Write",
      "url": "https://docs.aws.amazon.com/kinesisanalytics/latest/dev/API_UntagResource.html"
    },
    {
      "name": "UpdateApplication",
      "methodName": "toUpdateApplication",
      "description": "Grants permission to update the application",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/kinesisanalytics/latest/dev/API_UpdateApplication.html"
    },
    {
      "name": "GetApplicationState",
      "methodName": "toGetApplicationState",
      "description": "Grants permission to Kinesis Data Analytics console to display stream results for Kinesis Data Analytics SQL runtime applications",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/kinesisanalytics/latest/dev/api-permissions-reference.html#api-permissions-reference-gas"
    }
  ],
  "resources": [
    {
      "name": "application",
      "methodName": "onApplication",
      "url": "https://docs.aws.amazon.com/kinesisanalytics/latest/dev/how-it-works.html",
      "arn": "arn:${Partition}:kinesisanalytics:${Region}:${Account}:application/${ApplicationName}",
      "placeholders": [
        {
          "placeholder": "ApplicationName",
          "name": "applicationName",
          "kind": "required"
        },
        {
          "placeholder": "Account",
          "name": "account",
          "kind": "account"
        },
        {
          "placeholder": "Region",
          "name": "region",
          "kind": "region"
        },
        {
          "placeholder": "Partition",
          "name": "partition",
          "kind": "partition"
        }
      ],
      "conditionMethods": [
        "ifAwsResourceTag"
      ]
    }
  ],
  "conditions": [
    {
      "key": "aws:RequestTag/${TagKey}",
      "methodName": "ifAwsRequestTag",
      "description": "Filters access by set of values for each of the tags",
      "url": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_condition-keys.html#condition-keys-requesttag",
      "relatedActionMethods": [
        "toCreateApplication",
        "toTagResource"
      ],
      "relatedResourceTypes": [],
      "keyLiteral": "aws:RequestTag/",
      "valueKind": "string",
      "defaultOperator": "StringLike",
      "keyParam": "tagKey",
      "valueTypes": [
        "string"
      ],
      "operatorUrl": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_condition_operators.html#Conditions_String"
    },
    {
      "key": "aws:ResourceTag/${TagKey}",
      "methodName": "ifAwsResourceTag",
      "description": "Filters access by tag-value assoicated with the resource",
      "url": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_condition-keys.html#condition-keys-resourcetag",
      "relatedActionMethods": [
        "toAddApplicationInput",
        "toAddApplicationOutput",
        "toAddApplicationReferenceDataSource",
        "toDeleteApplication",
        "toDeleteApplicationOutput",
        "toDeleteApplicationReferenceDataSource",
        "toDescribeApplication",
        "toListTagsForResource",
        "toStartApplication",
        "toStopApplication",
        "toTagResource",
        "toUntagResource",
        "toUpdateApplication",
        "toGetApplicationState"
      ],
      "relatedResourceTypes": [
        "application"
      ],
      "keyLiteral": "aws:ResourceTag/",
      "valueKind": "string",
      "defaultOperator": "StringLike",
      "keyParam": "tagKey",
      "valueTypes": [
        "string"
      ],
      "operatorUrl": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_condition_operators.html#Conditions_String"
    },
    {
      "key": "aws:TagKeys",
      "methodName": "ifAwsTagKeys",
      "description": "Filters access by the presence of mandatory tag keys in the request",
      "url": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_condition-keys.html#condition-keys-tagkeys",
      "relatedActionMethods": [
        "toCreateApplication",
        "toTagResource",
        "toUntagResource"
      ],
      "relatedResourceTypes": [],
      "keyLiteral": "aws:TagKeys",
      "valueKind": "string",
      "defaultOperator": "ForAnyValue:StringLike",
      "valueTypes": [
        "string"
      ],
      "operatorUrl": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_condition_operators.html#Conditions_String"
    }
  ]
