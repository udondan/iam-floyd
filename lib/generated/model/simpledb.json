{
  "schemaVersion": 1,
  "filename": "simpledb",
  "className": "Sdb",
  "name": "sdb",
  "servicePrefix": "sdb",
  "url": "https://docs.aws.amazon.com/service-authorization/latest/reference/list_simpledb.html",
  "accessLevelList": {
    "Write": [
      "BatchDeleteAttributes",
      "BatchPutAttributes",
      "CreateDomain",
      "DeleteAttributes",
      "DeleteDomain",
      "PutAttributes",
      "StartDomainExport"
    ],
    "Read": [
      "DomainMetadata",
      "GetAttributes",
      "GetExport",
      "Select"
    ],
    "List": [
      "ListDomains",
      "ListExports"
    ]
  },
  "actions": [
    {
      "name": "BatchDeleteAttributes",
      "methodName": "toBatchDeleteAttributes",
      "description": "Grants permission to perform multiple DeleteAttributes operations in a single call, which reduces round trips and latencies",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/AmazonSimpleDB/latest/DeveloperGuide/SDB_API_BatchDeleteAttributes.html"
    },
    {
      "name": "BatchPutAttributes",
      "methodName": "toBatchPutAttributes",
      "description": "Grants permission to perform multiple PutAttribute operations in a single call, which reduces round trips and latencies",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/AmazonSimpleDB/latest/DeveloperGuide/SDB_API_BatchPutAttributes.html"
    },
    {
      "name": "CreateDomain",
      "methodName": "toCreateDomain",
      "description": "Grants permission to create a new domain",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/AmazonSimpleDB/latest/DeveloperGuide/SDB_API_CreateDomain.html"
    },
    {
      "name": "DeleteAttributes",
      "methodName": "toDeleteAttributes",
      "description": "Grants permission to delete one or more attributes associated with the item",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/AmazonSimpleDB/latest/DeveloperGuide/SDB_API_DeleteAttributes.html"
    },
    {
      "name": "DeleteDomain",
      "methodName": "toDeleteDomain",
      "description": "Grants permission to delete a domain",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/AmazonSimpleDB/latest/DeveloperGuide/SDB_API_DeleteDomain.html"
    },
    {
      "name": "DomainMetadata",
      "methodName": "toDomainMetadata",
      "description": "Grants permission to return information about the domain, including when the domain was created, the number of items and attributes, and the size of attribute names and values",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/AmazonSimpleDB/latest/DeveloperGuide/SDB_API_DomainMetadata.html"
    },
    {
      "name": "GetAttributes",
      "methodName": "toGetAttributes",
      "description": "Grants permission to return all of the attributes associated with the item",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/AmazonSimpleDB/latest/DeveloperGuide/SDB_API_GetAttributes.html"
    },
    {
      "name": "GetExport",
      "methodName": "toGetExport",
      "description": "Grants permission to return information for an existing domain export arn",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/AmazonSimpleDB/latest/DeveloperGuide/SDB_API_GetExport.html"
    },
    {
      "name": "ListDomains",
      "methodName": "toListDomains",
      "description": "Grants permission to list all domains",
      "accessLevel": "List",
      "url": "https://docs.aws.amazon.com/AmazonSimpleDB/latest/DeveloperGuide/SDB_API_ListDomains.html"
    },
    {
      "name": "ListExports",
      "methodName": "toListExports",
      "description": "Grants permission to list all exports that were created. The results are paginated and can be filtered by domain name",
      "accessLevel": "List",
      "url": "https://docs.aws.amazon.com/AmazonSimpleDB/latest/DeveloperGuide/SDB_API_ListExports.html"
    },
    {
      "name": "PutAttributes",
      "methodName": "toPutAttributes",
      "description": "Grants permission to create or replace attributes in an item",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/AmazonSimpleDB/latest/DeveloperGuide/SDB_API_PutAttributes.html"
    },
    {
      "name": "Select",
      "methodName": "toSelect",
      "description": "Grants permission to execute a query against the items in a domain",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/AmazonSimpleDB/latest/DeveloperGuide/SDB_API_Select.html"
    },
    {
      "name": "StartDomainExport",
      "methodName": "toStartDomainExport",
      "description": "Grants permission to initiates the export of a SimpleDB domain to an S3 bucket",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/AmazonSimpleDB/latest/DeveloperGuide/SDB_API_StartDomainExport.html"
    }
  ],
  "resources": [
    {
      "name": "domain",
      "methodName": "onDomain",
      "url": "https://docs.aws.amazon.com/AmazonSimpleDB/latest/DeveloperGuide/DataModel.html",
      "arn": "arn:${Partition}:sdb:${Region}:${Account}:domain/${DomainName}",
      "placeholders": [
        {
          "placeholder": "DomainName",
          "name": "domainName",
          "kind": "required"
        },
        {
          "placeholder": "Account",
          "name": "account",
          "kind": "account"
        },
        {
          "placeholder": "Region",
          "name": "region",
          "kind": "region"
        },
        {
          "placeholder": "Partition",
          "name": "partition",
          "kind": "partition"
        }
      ],
      "conditionMethods": []
    },
    {
      "name": "export",
      "methodName": "onExport",
      "url": "https://docs.aws.amazon.com/AmazonSimpleDB/latest/DeveloperGuide/DataModel.html",
      "arn": "arn:${Partition}:sdb:${Region}:${Account}:domain/${DomainName}/export/${ExportUUID}",
      "placeholders": [
        {
          "placeholder": "DomainName",
          "name": "domainName",
          "kind": "required"
        },
        {
          "placeholder": "ExportUUID",
          "name": "exportUUID",
          "kind": "required"
        },
        {
          "placeholder": "Account",
          "name": "account",
          "kind": "account"
        },
        {
          "placeholder": "Region",
          "name": "region",
          "kind": "region"
        },
        {
          "placeholder": "Partition",
          "name": "partition",
          "kind": "partition"
        }
      ],
      "conditionMethods": []
    }
  ],
  "conditions": []
}
