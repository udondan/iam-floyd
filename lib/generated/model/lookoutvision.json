      "methodName": "toDetectAnomalies",
      "description": "Grants permission to invoke detection of anomalies",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/lookout-for-vision/latest/APIReference/API_DetectAnomalies.html"
