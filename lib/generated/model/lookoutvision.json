{
  "schemaVersion": 1,
  "filename": "lookoutvision",
  "className": "Lookoutvision",
  "name": "lookoutvision",
  "servicePrefix": "lookoutvision",
  "url": "https://docs.aws.amazon.com/service-authorization/latest/reference/list_lookoutvision.html",
  "accessLevelList": {
