      "url": "https://docs.aws.amazon.com/lookout-for-vision/latest/developer-guide/model-create-project.html",
      "arn": "arn:${Partition}:lookoutvision:${Region}:${Account}:model/${ProjectName}/${ModelVersion}",
      "placeholders": [
        {
          "placeholder": "ProjectName",
          "name": "projectName",
          "kind": "required"
        },
        {
          "placeholder": "ModelVersion",
          "name": "modelVersion",
          "kind": "required"
        },
        {
          "placeholder": "Account",
          "name": "account",
          "kind": "account"
        },
        {
          "placeholder": "Region",
          "name": "region",
          "kind": "region"
        },
        {
          "placeholder": "Partition",
          "name": "partition",
          "kind": "partition"
        }
      ],
      "conditionMethods": [
        "ifAwsResourceTag"
      ]
    },
    {
      "name": "project",
      "methodName": "onProject",
      "url": "https://docs.aws.amazon.com/lookout-for-vision/latest/developer-guide/model-create-project.html",
      "arn": "arn:${Partition}:lookoutvision:${Region}:${Account}:project/${ProjectName}",
      "placeholders": [
        {
          "placeholder": "ProjectName",
          "name": "projectName",
          "kind": "required"
        },
        {
          "placeholder": "Account",
          "name": "account",
          "kind": "account"
        },
        {
          "placeholder": "Region",
          "name": "region",
          "kind": "region"
        },
        {
          "placeholder": "Partition",
          "name": "partition",
          "kind": "partition"
        }
      ],
      "conditionMethods": []
    }
