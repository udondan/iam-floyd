    {
      "name": "StopModel",
      "methodName": "toStopModel",
      "description": "Grants permission to stop anomaly detection model",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/lookout-for-vision/latest/APIReference/API_StopModel.html"
