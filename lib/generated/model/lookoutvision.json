    {
      "name": "DescribeModelPackagingJob",
      "methodName": "toDescribeModelPackagingJob",
      "description": "Grants permission to show detailed information about a model packaging job",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/lookout-for-vision/latest/APIReference/API_DescribeModelPackagingJob.html"
