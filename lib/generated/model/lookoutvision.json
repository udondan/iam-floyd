    {
      "name": "UntagResource",
      "methodName": "toUntagResource",
      "description": "Grants permission to remove the tag with the given key from a resource",
      "accessLevel": "Tagging, Write",
      "url": "https://docs.aws.amazon.com/lookout-for-vision/latest/APIReference/API_UntagResource.html"
    },
    {
      "name": "UpdateDatasetEntries",
      "methodName": "toUpdateDatasetEntries",
      "description": "Grants permission to update a training or test dataset manifest",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/lookout-for-vision/latest/APIReference/API_UpdateDatasetEntries.html"
    },
    {
      "name": "DescribeTrialDetection",
      "methodName": "toDescribeTrialDetection",
