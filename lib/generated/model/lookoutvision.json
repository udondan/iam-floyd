    {
      "name": "StartTrialDetection",
      "methodName": "toStartTrialDetection",
      "description": "Grants permission to start bulk detection of anomalies for a set of images stored in an S3 bucket",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/lookout-for-vision/latest/developer-guide/trial-detection.html"
