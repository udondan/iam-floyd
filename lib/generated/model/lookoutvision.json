    },
    {
      "name": "CreateModel",
      "methodName": "toCreateModel",
      "description": "Grants permission to create a new anomaly detection model",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/lookout-for-vision/latest/APIReference/API_CreateModel.html"
    },
    {
      "name": "CreateProject",
      "methodName": "toCreateProject",
