      "valueTypes": [
        "string"
      ],
      "operatorUrl": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_condition_operators.html#Conditions_String"
    },
    {
      "key": "health:service",
      "methodName": "ifService",
      "description": "Filters access by impacted service",
      "url": "https://docs.aws.amazon.com/health/latest/ug/controlling-access.html",
      "relatedActionMethods": [
        "toDescribeAffectedEntities",
        "toDescribeEventDetails"
      ],
      "relatedResourceTypes": [],
