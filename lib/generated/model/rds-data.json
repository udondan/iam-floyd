{
  "schemaVersion": 1,
  "filename": "rds-data",
  "className": "RdsData",
  "name": "rds-data",
  "servicePrefix": "rds-data",
  "url": "https://docs.aws.amazon.com/service-authorization/latest/reference/list_rds-data.html",
  "accessLevelList": {
    "Write": [
      "BatchExecuteStatement",
      "BeginTransaction",
      "CommitTransaction",
      "ExecuteSql",
      "ExecuteStatement",
      "RollbackTransaction"
    ]
  },
  "actions": [
    {
      "name": "BatchExecuteStatement",
      "methodName": "toBatchExecuteStatement",
      "description": "Grants permission to run a batch SQL statement over an array of data",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/rdsdataservice/latest/APIReference/API_BatchExecuteStatement.html"
    },
    {
      "name": "BeginTransaction",
      "methodName": "toBeginTransaction",
      "description": "Grants permission to start a SQL transaction",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/rdsdataservice/latest/APIReference/API_BeginTransaction.html"
    },
    {
      "name": "CommitTransaction",
      "methodName": "toCommitTransaction",
      "description": "Grants permission to end a SQL transaction started with the BeginTransaction operation and commits the changes",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/rdsdataservice/latest/APIReference/API_CommitTransaction.html"
    },
    {
      "name": "ExecuteSql",
      "methodName": "toExecuteSql",
      "description": "Grants permission to run one or more SQL statements. This operation is deprecated. Use the BatchExecuteStatement or ExecuteStatement operation",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/rdsdataservice/latest/APIReference/API_ExecuteSql.html"
    },
    {
      "name": "ExecuteStatement",
      "methodName": "toExecuteStatement",
      "description": "Grants permission to run a SQL statement against a database",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/rdsdataservice/latest/APIReference/API_ExecuteStatement.html"
    },
    {
      "name": "RollbackTransaction",
      "methodName": "toRollbackTransaction",
      "description": "Grants permission to perform a rollback of a transaction. Rolling back a transaction cancels its changes",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/rdsdataservice/latest/APIReference/API_RollbackTransaction.html"
    }
  ],
  "resources": [
    {
      "name": "cluster",
      "methodName": "onCluster",
      "url": "https://docs.aws.amazon.com/AmazonRDS/latest/UserGuide/Aurora.Managing.html",
      "arn": "arn:${Partition}:rds:${Region}:${Account}:cluster:${DbClusterInstanceName}",
      "placeholders": [
        {
          "placeholder": "DbClusterInstanceName",
          "name": "dbClusterInstanceName",
          "kind": "required"
        },
        {
          "placeholder": "Account",
          "name": "account",
          "kind": "account"
        },
        {
          "placeholder": "Region",
          "name": "region",
          "kind": "region"
        },
        {
          "placeholder": "Partition",
          "name": "partition",
          "kind": "partition"
        }
      ],
      "conditionMethods": [
        "ifAwsResourceTag",
        "ifAwsTagKeys"
      ]
    }
  ],
  "conditions": [
    {
      "key": "aws:ResourceTag/${TagKey}",
      "methodName": "ifAwsResourceTag",
      "description": "Filters access by the tags associated with the resource",
      "url": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_condition-keys.html#condition-keys-resourcetag",
      "relatedActionMethods": [
        "toBatchExecuteStatement",
        "toBeginTransaction",
        "toCommitTransaction",
        "toExecuteSql",
        "toExecuteStatement",
        "toRollbackTransaction"
      ],
      "relatedResourceTypes": [
        "cluster"
      ],
      "keyLiteral": "aws:ResourceTag/",
      "valueKind": "string",
      "defaultOperator": "StringLike",
      "keyParam": "tagKey",
      "valueTypes": [
        "string"
      ],
      "operatorUrl": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_condition_operators.html#Conditions_String"
    },
    {
      "key": "aws:TagKeys",
      "methodName": "ifAwsTagKeys",
      "description": "Filters access by the tag keys associated with the resource",
      "url": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_condition-keys.html#condition-keys-tagkeys",
      "relatedActionMethods": [
        "toBatchExecuteStatement",
        "toBeginTransaction",
        "toCommitTransaction",
        "toExecuteSql",
        "toExecuteStatement",
        "toRollbackTransaction"
      ],
      "relatedResourceTypes": [
        "cluster"
      ],
      "keyLiteral": "aws:TagKeys",
      "valueKind": "string",
      "defaultOperator": "StringLike",
      "valueTypes": [
        "string"
      ],
      "operatorUrl": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_condition_operators.html#Conditions_String"
    }
  ]
}
