{
  "schemaVersion": 1,
  "filename": "bcm-data-hub",
  "className": "BcmDataHub",
  "name": "bcm-data-hub",
  "servicePrefix": "bcm-data-hub",
  "url": "https://docs.aws.amazon.com/service-authorization/latest/reference/list_bcm-data-hub.html",
  "accessLevelList": {
    "Write": [
      "CancelQueryExecution",
      "CreateDataset",
      "DeleteDataset",
      "StartQueryExecution",
      "TagResource",
      "UntagResource",
      "UpdateDataset"
    ],
    "Read": [
