      "GetDatasetSchema",
      "GetQueryExecution",
      "GetQueryExecutionResults",
      "ListTagsForResource"
    ],
    "List": [
      "ListDatasets",
      "ListQueryExecutions"
    ],
    "Tagging": [
      "TagResource",
      "UntagResource"
    ]
  },
  "actions": [
    {
      "name": "CancelQueryExecution",
      "methodName": "toCancelQueryExecution",
      "description": "Grants permission to cancel a query execution",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/awsaccountbilling/latest/aboutv2/security-iam.html#sec-policies"
    },
    {
      "name": "CreateDataset",
      "methodName": "toCreateDataset",
      "description": "Grants permission to create a dataset",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/awsaccountbilling/latest/aboutv2/security-iam.html#sec-policies"
    },
    {
      "name": "DeleteDataset",
      "methodName": "toDeleteDataset",
      "description": "Grants permission to delete a dataset",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/awsaccountbilling/latest/aboutv2/security-iam.html#sec-policies"
    },
    {
      "name": "GetDataset",
      "methodName": "toGetDataset",
      "description": "Grants permission to get a dataset",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/awsaccountbilling/latest/aboutv2/security-iam.html#sec-policies"
    },
    {
      "name": "GetDatasetSchema",
      "methodName": "toGetDatasetSchema",
      "description": "Grants permission to get a dataset schema",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/awsaccountbilling/latest/aboutv2/security-iam.html#sec-policies"
    },
    {
      "name": "GetQueryExecution",
      "methodName": "toGetQueryExecution",
      "description": "Grants permission to get a query execution",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/awsaccountbilling/latest/aboutv2/security-iam.html#sec-policies"
    },
    {
      "name": "GetQueryExecutionResults",
      "methodName": "toGetQueryExecutionResults",
      "description": "Grants permission to get query execution results",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/awsaccountbilling/latest/aboutv2/security-iam.html#sec-policies"
    },
    {
      "name": "ListDatasets",
      "methodName": "toListDatasets",
      "description": "Grants permission to list datasets",
      "accessLevel": "List",
      "url": "https://docs.aws.amazon.com/awsaccountbilling/latest/aboutv2/security-iam.html#sec-policies"
    },
    {
      "name": "ListQueryExecutions",
      "methodName": "toListQueryExecutions",
      "description": "Grants permission to list query executions",
      "accessLevel": "List",
      "url": "https://docs.aws.amazon.com/awsaccountbilling/latest/aboutv2/security-iam.html#sec-policies"
    },
    {
      "name": "ListTagsForResource",
      "methodName": "toListTagsForResource",
      "description": "Grants permission to list tags for a resource",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/awsaccountbilling/latest/aboutv2/security-iam.html#sec-policies"
    },
    {
      "name": "StartQueryExecution",
      "methodName": "toStartQueryExecution",
      "description": "Grants permission to start a query execution",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/awsaccountbilling/latest/aboutv2/security-iam.html#sec-policies"
    },
    {
      "name": "TagResource",
      "methodName": "toTagResource",
      "description": "Grants permission to tag a resource",
      "accessLevel": "Tagging, Write",
      "url": "https://docs.aws.amazon.com/awsaccountbilling/latest/aboutv2/security-iam.html#sec-policies"
    },
    {
      "name": "UntagResource",
      "methodName": "toUntagResource",
      "description": "Grants permission to untag a resource",
      "accessLevel": "Tagging, Write",
      "url": "https://docs.aws.amazon.com/awsaccountbilling/latest/aboutv2/security-iam.html#sec-policies"
    },
    {
      "name": "UpdateDataset",
      "methodName": "toUpdateDataset",
      "description": "Grants permission to update a dataset",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/awsaccountbilling/latest/aboutv2/security-iam.html#sec-policies"
    }
