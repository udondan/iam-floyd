  "actions": [
    {
      "name": "CreateChatToken",
      "methodName": "toCreateChatToken",
      "description": "Grants permission to create an encrypted token that is used to establish an individual WebSocket connection to a room",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/ivs/latest/ChatAPIReference/API_CreateChatToken.html"
    },
    {
      "name": "CreateLoggingConfiguration",
      "methodName": "toCreateLoggingConfiguration",
      "description": "Grants permission to create a logging configuration that allows clients to record room messages",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/ivs/latest/ChatAPIReference/API_CreateLoggingConfiguration.html"
    },
    {
      "name": "CreateRoom",
      "methodName": "toCreateRoom",
      "description": "Grants permission to create a room that allows clients to connect and pass messages",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/ivs/latest/ChatAPIReference/API_CreateRoom.html"
    },
    {
      "name": "DeleteLoggingConfiguration",
      "methodName": "toDeleteLoggingConfiguration",
      "description": "Grants permission to delete the logging configuration for a specified logging configuration ARN",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/ivs/latest/ChatAPIReference/API_DeleteLoggingConfiguration.html"
    },
    {
      "name": "DeleteMessage",
      "methodName": "toDeleteMessage",
      "description": "Grants permission to send an event to a specific room which directs clients to delete a specific message",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/ivs/latest/ChatAPIReference/API_DeleteMessage.html"
    },
    {
      "name": "DeleteRoom",
      "methodName": "toDeleteRoom",
      "description": "Grants permission to delete the room for a specified room ARN",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/ivs/latest/ChatAPIReference/API_DeleteRoom.html"
    },
    {
      "name": "DisconnectUser",
      "methodName": "toDisconnectUser",
      "description": "Grants permission to disconnect all connections using a specified user ID from a room",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/ivs/latest/ChatAPIReference/API_DisconnectUser.html"
    },
    {
      "name": "GetLoggingConfiguration",
      "methodName": "toGetLoggingConfiguration",
      "description": "Grants permission to get the logging configuration for a specified logging configuration ARN",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/ivs/latest/ChatAPIReference/API_GetLoggingConfiguration.html"
    },
    {
      "name": "GetRoom",
      "methodName": "toGetRoom",
      "description": "Grants permission to get the room configuration for a specified room ARN",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/ivs/latest/ChatAPIReference/API_GetRoom.html"
    },
    {
      "name": "ListLoggingConfigurations",
      "methodName": "toListLoggingConfigurations",
      "description": "Grants permission to get summary information about logging configurations",
      "accessLevel": "List",
      "url": "https://docs.aws.amazon.com/ivs/latest/ChatAPIReference/API_ListLoggingConfigurations.html"
    },
    {
      "name": "ListRooms",
      "methodName": "toListRooms",
      "description": "Grants permission to get summary information about rooms",
      "accessLevel": "List",
      "url": "https://docs.aws.amazon.com/ivs/latest/ChatAPIReference/API_ListRooms.html"
    },
    {
      "name": "ListTagsForResource",
      "methodName": "toListTagsForResource",
      "description": "Grants permission to get information about the tags for a specified ARN",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/ivs/latest/ChatAPIReference/API_ListTagsForResource.html"
    },
    {
      "name": "SendEvent",
      "methodName": "toSendEvent",
      "description": "Grants permission to send an event to a room",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/ivs/latest/ChatAPIReference/API_SendEvent.html"
    },
    {
      "name": "TagResource",
      "methodName": "toTagResource",
      "description": "Grants permission to add or update tags for a resource with a specified ARN",
      "accessLevel": "Tagging, Write",
      "url": "https://docs.aws.amazon.com/ivs/latest/ChatAPIReference/API_TagResource.html"
    },
    {
      "name": "UntagResource",
      "methodName": "toUntagResource",
      "description": "Grants permission to remove tags for a resource with a specified ARN",
      "accessLevel": "Tagging, Write",
      "url": "https://docs.aws.amazon.com/ivs/latest/ChatAPIReference/API_UntagResource.html"
    },
    {
      "name": "UpdateLoggingConfiguration",
      "methodName": "toUpdateLoggingConfiguration",
      "description": "Grants permission to update the logging configuration for a specified logging configuration ARN",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/ivs/latest/ChatAPIReference/API_UpdateLoggingConfiguration.html"
    },
    {
      "name": "UpdateRoom",
      "methodName": "toUpdateRoom",
      "description": "Grants permission to update the room configuration for a specified room ARN",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/ivs/latest/ChatAPIReference/API_UpdateRoom.html"
    }
