      "arn": "arn:${Partition}:signer:${Region}:${Account}:/signing-jobs/${JobId}",
      "placeholders": [
        {
          "placeholder": "JobId",
          "name": "jobId",
          "kind": "required"
        },
        {
          "placeholder": "Account",
          "name": "account",
          "kind": "account"
        },
        {
          "placeholder": "Region",
          "name": "region",
          "kind": "region"
        },
        {
          "placeholder": "Partition",
          "name": "partition",
          "kind": "partition"
        }
      ],
      "conditionMethods": []
    },
    {
      "name": "signing-profile",
      "methodName": "onSigningProfile",
      "url": "https://docs.aws.amazon.com/signer/latest/developerguide/gs-profile.html",
      "arn": "arn:${Partition}:signer:${Region}:${Account}:/signing-profiles/${ProfileName}",
      "placeholders": [
        {
          "placeholder": "ProfileName",
          "name": "profileName",
          "kind": "required"
        },
        {
          "placeholder": "Account",
          "name": "account",
          "kind": "account"
        },
        {
          "placeholder": "Region",
          "name": "region",
          "kind": "region"
        },
        {
          "placeholder": "Partition",
          "name": "partition",
          "kind": "partition"
        }
      ],
      "conditionMethods": [
        "ifAwsResourceTag"
      ]
    }
