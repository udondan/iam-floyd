{
  "schemaVersion": 1,
  "filename": "snow-device-management",
  "className": "SnowDeviceManagement",
  "name": "snow-device-management",
  "servicePrefix": "snow-device-management",
  "url": "https://docs.aws.amazon.com/service-authorization/latest/reference/list_snow-device-management.html",
  "accessLevelList": {
    "Write": [
      "CancelTask",
      "CreateTask",
      "TagResource",
      "UntagResource"
    ],
    "Read": [
      "DescribeDevice",
      "DescribeDeviceEc2Instances",
      "DescribeExecution",
      "DescribeTask",
      "ListTagsForResource"
    ],
    "List": [
      "ListDeviceResources",
      "ListDevices",
      "ListExecutions",
      "ListTasks"
    ],
    "Tagging": [
      "TagResource",
      "UntagResource"
    ]
  },
  "actions": [
    {
      "name": "CancelTask",
      "methodName": "toCancelTask",
      "description": "Grants permission to cancel tasks on remote devices",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/snowball/latest/developer-guide/aws-sdm.html#sdm-cli-cancel-task"
    },
    {
      "name": "CreateTask",
      "methodName": "toCreateTask",
      "description": "Grants permission to create tasks on remote devices",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/snowball/latest/developer-guide/aws-sdm.html#sdm-cli-create-task",
      "conditionMethods": [
        "ifAwsRequestTag",
        "ifAwsResourceTag",
        "ifAwsTagKeys"
      ]
    },
    {
      "name": "DescribeDevice",
      "methodName": "toDescribeDevice",
      "description": "Grants permission to describe a remotely-managed device",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/snowball/latest/developer-guide/aws-sdm.html#sdm-cli-describe-device"
    },
    {
      "name": "DescribeDeviceEc2Instances",
      "methodName": "toDescribeDeviceEc2Instances",
      "description": "Grants permission to describe a remotely-managed device's EC2 instances",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/snowball/latest/developer-guide/aws-sdm.html#sdm-cli-describe-ec2-instances"
    },
    {
      "name": "DescribeExecution",
      "methodName": "toDescribeExecution",
      "description": "Grants permission to describe task executions",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/snowball/latest/developer-guide/aws-sdm.html#sdm-cli-describe-execution"
    },
    {
      "name": "DescribeTask",
      "methodName": "toDescribeTask",
      "description": "Grants permission to describe a task",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/snowball/latest/developer-guide/aws-sdm.html#sdm-cli-describe-task"
    },
    {
      "name": "ListDeviceResources",
      "methodName": "toListDeviceResources",
      "description": "Grants permission to list a remotely-managed device's resources",
      "accessLevel": "List",
      "url": "https://docs.aws.amazon.com/snowball/latest/developer-guide/aws-sdm.html#sdm-cli-list-device-resources"
    },
    {
      "name": "ListDevices",
      "methodName": "toListDevices",
      "description": "Grants permission to list remotely-managed devices",
      "accessLevel": "List",
      "url": "https://docs.aws.amazon.com/snowball/latest/developer-guide/aws-sdm.html#sdm-cli-list-devices"
    },
    {
      "name": "ListExecutions",
      "methodName": "toListExecutions",
      "description": "Grants permission to list task executions",
      "accessLevel": "List",
      "url": "https://docs.aws.amazon.com/snowball/latest/developer-guide/aws-sdm.html#sdm-cli-list-executions"
    },
    {
      "name": "ListTagsForResource",
      "methodName": "toListTagsForResource",
      "description": "Grants permission to list the tags for a resource (device or task)",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/snowball/latest/developer-guide/aws-sdm.html#sdm-cli-list-tags-for-resource",
      "conditionMethods": [
        "ifAwsRequestTag",
        "ifAwsTagKeys"
      ]
    },
    {
      "name": "ListTasks",
      "methodName": "toListTasks",
      "description": "Grants permission to list tasks",
      "accessLevel": "List",
      "url": "https://docs.aws.amazon.com/snowball/latest/developer-guide/aws-sdm.html#sdm-cli-list-tasks"
    },
    {
      "name": "TagResource",
      "methodName": "toTagResource",
      "description": "Grants permission to tag a resource",
      "accessLevel": "Tagging, Write",
      "url": "https://docs.aws.amazon.com/snowball/latest/developer-guide/aws-sdm.html#sdm-cli-tag-resource"
    },
    {
      "name": "UntagResource",
      "methodName": "toUntagResource",
      "description": "Grants permission to untag a resource",
      "accessLevel": "Tagging, Write",
      "url": "https://docs.aws.amazon.com/snowball/latest/developer-guide/aws-sdm.html#sdm-cli-untag-resources"
    }
  ],
  "resources": [
    {
      "name": "managed-device",
      "methodName": "onManagedDevice",
      "url": "https://docs.aws.amazon.com/snowball/latest/developer-guide/aws-sdm.html",
      "arn": "arn:${Partition}:snow-device-management:${Region}:${Account}:managed-device/${ResourceId}",
      "placeholders": [
        {
          "placeholder": "ResourceId",
          "name": "resourceId",
          "kind": "required"
        },
        {
          "placeholder": "Account",
          "name": "account",
          "kind": "account"
        },
        {
          "placeholder": "Region",
          "name": "region",
          "kind": "region"
        },
        {
          "placeholder": "Partition",
          "name": "partition",
          "kind": "partition"
        }
      ],
      "conditionMethods": [
        "ifAwsResourceTag"
      ]
    },
    {
      "name": "task",
      "methodName": "onTask",
      "url": "https://docs.aws.amazon.com/snowball/latest/developer-guide/aws-sdm.html",
      "arn": "arn:${Partition}:snow-device-management:${Region}:${Account}:task/${ResourceId}",
      "placeholders": [
        {
          "placeholder": "ResourceId",
          "name": "resourceId",
          "kind": "required"
        },
        {
          "placeholder": "Account",
          "name": "account",
          "kind": "account"
        },
        {
          "placeholder": "Region",
          "name": "region",
          "kind": "region"
        },
        {
          "placeholder": "Partition",
          "name": "partition",
          "kind": "partition"
        }
      ],
      "conditionMethods": [
        "ifAwsResourceTag"
      ]
    }
  ],
  "conditions": [
    {
      "key": "aws:RequestTag/${TagKey}",
      "methodName": "ifAwsRequestTag",
      "description": "Filters access by a tag's key and value in a request",
      "url": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_condition-keys.html#condition-keys-requesttag",
      "relatedActionMethods": [
        "toCreateTask",
        "toListTagsForResource",
        "toTagResource"
      ],
      "relatedResourceTypes": [],
      "keyLiteral": "aws:RequestTag/",
      "valueKind": "string",
      "defaultOperator": "StringLike",
      "keyParam": "tagKey",
      "valueTypes": [
        "string"
      ],
      "operatorUrl": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_condition_operators.html#Conditions_String"
    },
    {
      "key": "aws:ResourceTag/${TagKey}",
      "methodName": "ifAwsResourceTag",
      "description": "Filters access by the presence of tag key-value pairs attached to the resource",
      "url": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_condition-keys.html#condition-keys-resourcetag",
      "relatedActionMethods": [
        "toCancelTask",
        "toCreateTask",
        "toDescribeDevice",
        "toDescribeDeviceEc2Instances",
        "toDescribeTask",
        "toListDeviceResources",
        "toTagResource",
        "toUntagResource"
      ],
      "relatedResourceTypes": [
        "managed-device",
        "task"
      ],
      "keyLiteral": "aws:ResourceTag/",
      "valueKind": "string",
      "defaultOperator": "StringLike",
      "keyParam": "tagKey",
      "valueTypes": [
        "string"
      ],
      "operatorUrl": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_condition_operators.html#Conditions_String"
    },
    {
      "key": "aws:TagKeys",
      "methodName": "ifAwsTagKeys",
      "description": "Filters access by the presence of tag keys in the request",
      "url": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_condition-keys.html#condition-keys-tagkeys",
      "relatedActionMethods": [
        "toCreateTask",
        "toListTagsForResource",
        "toTagResource",
        "toUntagResource"
      ],
      "relatedResourceTypes": [],
      "keyLiteral": "aws:TagKeys",
      "valueKind": "string",
      "defaultOperator": "StringLike",
      "valueTypes": [
        "string"
      ],
      "operatorUrl": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_condition_operators.html#Conditions_String"
    }
