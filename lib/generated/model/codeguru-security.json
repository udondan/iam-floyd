{
  "schemaVersion": 1,
  "filename": "codeguru-security",
  "className": "CodeguruSecurity",
  "name": "codeguru-security",
  "servicePrefix": "codeguru-security",
  "url": "https://docs.aws.amazon.com/service-authorization/latest/reference/list_codeguru-security.html",
  "accessLevelList": {
    "Read": [
      "BatchGetFindings",
      "GetAccountConfiguration",
      "GetMetricsSummary",
      "GetScan",
      "ListTagsForResource"
    ],
    "Write": [
      "CreateScan",
      "CreateUploadUrl",
      "TagResource",
      "UntagResource",
      "UpdateAccountConfiguration",
      "DeleteScansByCategory"
    ],
    "List": [
      "GetFindings",
      "ListFindingsMetrics",
      "ListScans",
      "ListFindings"
    ],
    "Tagging": [
      "TagResource",
      "UntagResource"
    ]
  },
  "actions": [
    {
      "name": "BatchGetFindings",
      "methodName": "toBatchGetFindings",
      "description": "Grants permission to batch retrieve specific findings generated by CodeGuru Security",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/codeguru/latest/security-api/API_BatchGetFindings.html"
    },
    {
      "name": "CreateScan",
      "methodName": "toCreateScan",
      "description": "Grants permission to create a CodeGuru Security scan",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/codeguru/latest/security-api/API_CreateScan.html"
    },
    {
      "name": "CreateUploadUrl",
      "methodName": "toCreateUploadUrl",
      "description": "Grants permission to generate a presigned url for uploading code archives",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/codeguru/latest/security-api/API_CreateUploadUrl.html"
    },
    {
      "name": "GetAccountConfiguration",
      "methodName": "toGetAccountConfiguration",
      "description": "Grants permission to retrieve the account level configurations",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/codeguru/latest/security-api/API_GetAccountConfiguration.html"
    },
    {
      "name": "GetFindings",
      "methodName": "toGetFindings",
      "description": "Grants permission to retrieve findings for a scan generated by CodeGuru Security",
      "accessLevel": "List",
      "url": "https://docs.aws.amazon.com/codeguru/latest/security-api/API_GetFindings.html"
    },
    {
      "name": "GetMetricsSummary",
      "methodName": "toGetMetricsSummary",
      "description": "Grants permission to retrieve AWS accout level metrics summary generated by CodeGuru Security",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/codeguru/latest/security-api/API_GetMetricsSummary.html"
    },
    {
      "name": "GetScan",
      "methodName": "toGetScan",
      "description": "Grants permission to retrieve CodeGuru Security scan metadata",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/codeguru/latest/security-api/API_GetScan.html"
    },
    {
      "name": "ListFindingsMetrics",
      "methodName": "toListFindingsMetrics",
      "description": "Grants permission to retrieve a list of account level findings metrics within a date range",
      "accessLevel": "List",
      "url": "https://docs.aws.amazon.com/codeguru/latest/security-api/API_ListFindingsMetrics.html"
    },
    {
      "name": "ListScans",
      "methodName": "toListScans",
      "description": "Grants permission to retrieve list of CodeGuru Security scan metadata",
      "accessLevel": "List",
      "url": "https://docs.aws.amazon.com/codeguru/latest/security-api/API_ListScans.html"
    },
    {
      "name": "ListTagsForResource",
      "methodName": "toListTagsForResource",
      "description": "Grants permission to retrieve a list of tags for a scan name ARN",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/codeguru/latest/security-api/API_ListTagsForResource.html"
    },
    {
      "name": "TagResource",
      "methodName": "toTagResource",
      "description": "Grants permission to add tags to a scan name ARN",
      "accessLevel": "Tagging, Write",
      "url": "https://docs.aws.amazon.com/codeguru/latest/security-api/API_TagResource.html"
    },
    {
      "name": "UntagResource",
      "methodName": "toUntagResource",
      "description": "Grants permission to remove tags from a scan name ARN",
      "accessLevel": "Tagging, Write",
      "url": "https://docs.aws.amazon.com/codeguru/latest/security-api/API_UntagResource.html"
    },
    {
      "name": "UpdateAccountConfiguration",
      "methodName": "toUpdateAccountConfiguration",
      "description": "Grants permission to update the account level configurations",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/codeguru/latest/security-api/API_UpdateAccountConfiguration.html"
    },
    {
      "name": "DeleteScansByCategory",
      "methodName": "toDeleteScansByCategory",
      "description": "Grants permission to delete all the scans and related findings from CodeGuru Security by given category",
      "accessLevel": "Write",
      "url": ""
    },
    {
      "name": "ListFindings",
      "methodName": "toListFindings",
      "description": "Grants permission to retrieve findings generated by CodeGuru Security",
      "accessLevel": "List",
      "url": ""
    }
  ],
  "resources": [
    {
      "name": "ScanName",
      "methodName": "onScanName",
      "url": "https://docs.aws.amazon.com/codeguru/latest/security-ug/working-with-code-scans.html",
      "arn": "arn:${Partition}:codeguru-security:${Region}:${Account}:scans/${ScanName}",
      "placeholders": [
        {
          "placeholder": "ScanName",
          "name": "scanName",
          "kind": "required"
        },
        {
          "placeholder": "Account",
          "name": "account",
          "kind": "account"
        },
        {
          "placeholder": "Region",
          "name": "region",
          "kind": "region"
        },
        {
          "placeholder": "Partition",
          "name": "partition",
          "kind": "partition"
        }
      ],
      "conditionMethods": [
        "ifAwsResourceTag"
      ]
    }
  ],
  "conditions": [
    {
      "key": "aws:RequestTag/${TagKey}",
      "methodName": "ifAwsRequestTag",
      "description": "Filters access by the tags that are passed in the request",
      "url": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_condition-keys.html#condition-keys-requesttag",
      "relatedActionMethods": [
        "toCreateScan",
        "toTagResource"
      ],
      "relatedResourceTypes": [],
      "keyLiteral": "aws:RequestTag/",
      "valueKind": "string",
      "defaultOperator": "StringLike",
      "keyParam": "tagKey",
      "valueTypes": [
        "string"
      ],
      "operatorUrl": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_condition_operators.html#Conditions_String"
    },
    {
      "key": "aws:ResourceTag/${TagKey}",
      "methodName": "ifAwsResourceTag",
      "description": "Filters access by the tags associated with the resource",
      "url": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_condition-keys.html#condition-keys-resourcetag",
      "relatedActionMethods": [
        "toBatchGetFindings",
        "toCreateScan",
        "toCreateUploadUrl",
        "toGetFindings",
        "toGetScan",
        "toListTagsForResource",
        "toTagResource",
        "toUntagResource"
      ],
      "relatedResourceTypes": [
        "ScanName"
      ],
      "keyLiteral": "aws:ResourceTag/",
      "valueKind": "string",
      "defaultOperator": "StringLike",
      "keyParam": "tagKey",
      "valueTypes": [
        "string"
      ],
      "operatorUrl": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_condition_operators.html#Conditions_String"
    },
    {
      "key": "aws:TagKeys",
      "methodName": "ifAwsTagKeys",
      "description": "Filters access by the tag keys that are passed in the request",
      "url": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_condition-keys.html#condition-keys-tagkeys",
      "relatedActionMethods": [
        "toCreateScan",
        "toTagResource",
        "toUntagResource"
      ],
      "relatedResourceTypes": [],
      "keyLiteral": "aws:TagKeys",
      "valueKind": "string",
      "defaultOperator": "StringLike",
      "valueTypes": [
        "string"
      ],
      "operatorUrl": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_condition_operators.html#Conditions_String"
    }
  ]
}
