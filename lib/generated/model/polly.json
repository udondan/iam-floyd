{
  "schemaVersion": 1,
  "filename": "polly",
  "className": "Polly",
  "name": "polly",
  "servicePrefix": "polly",
  "url": "https://docs.aws.amazon.com/service-authorization/latest/reference/list_polly.html",
  "accessLevelList": {
    "Write": [
      "DeleteLexicon",
      "PutLexicon",
      "StartSpeechSynthesisTask"
    ],
    "List": [
      "DescribeVoices",
      "ListLexicons",
      "ListSpeechSynthesisTasks"
    ],
    "Read": [
      "GetLexicon",
      "GetSpeechSynthesisTask",
      "StartSpeechSynthesisStream",
      "SynthesizeSpeech"
    ]
  },
  "actions": [
    {
      "name": "DeleteLexicon",
      "methodName": "toDeleteLexicon",
      "description": "Grants permission to delete the specified pronunciation lexicon stored in an AWS Region",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/polly/latest/dg/API_DeleteLexicon.html"
    },
    {
      "name": "DescribeVoices",
      "methodName": "toDescribeVoices",
      "description": "Grants permission to describe the list of voices that are available for use when requesting speech synthesis",
      "accessLevel": "List",
      "url": "https://docs.aws.amazon.com/polly/latest/dg/API_DescribeVoices.html"
    },
    {
      "name": "GetLexicon",
      "methodName": "toGetLexicon",
      "description": "Grants permission to retrieve the content of the specified pronunciation lexicon stored in an AWS Region",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/polly/latest/dg/API_GetLexicon.html"
    },
    {
      "name": "GetSpeechSynthesisTask",
      "methodName": "toGetSpeechSynthesisTask",
      "description": "Grants permission to get information about specific speech synthesis task",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/polly/latest/dg/API_GetSpeechSynthesisTask.html"
    },
    {
      "name": "ListLexicons",
      "methodName": "toListLexicons",
      "description": "Grants permission to list the pronunciation lexicons stored in an AWS Region",
      "accessLevel": "List",
      "url": "https://docs.aws.amazon.com/polly/latest/dg/API_ListLexicons.html"
    },
    {
      "name": "ListSpeechSynthesisTasks",
      "methodName": "toListSpeechSynthesisTasks",
      "description": "Grants permission to list requested speech synthesis tasks",
      "accessLevel": "List",
      "url": "https://docs.aws.amazon.com/polly/latest/dg/API_ListSpeechSynthesisTasks.html"
    },
    {
      "name": "PutLexicon",
      "methodName": "toPutLexicon",
      "description": "Grants permission to store a pronunciation lexicon in an AWS Region",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/polly/latest/dg/API_PutLexicon.html"
    },
    {
      "name": "StartSpeechSynthesisStream",
      "methodName": "toStartSpeechSynthesisStream",
      "description": "Grants permission to perform synthesis with bidirectional streaming",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/polly/latest/dg/API_StartSpeechSynthesisStream.html"
    },
    {
      "name": "StartSpeechSynthesisTask",
      "methodName": "toStartSpeechSynthesisTask",
      "description": "Grants permission to synthesize long inputs to the provided S3 location",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/polly/latest/dg/API_StartSpeechSynthesisTask.html"
    },
    {
      "name": "SynthesizeSpeech",
      "methodName": "toSynthesizeSpeech",
      "description": "Grants permission to synthesize speech",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/polly/latest/dg/API_SynthesizeSpeech.html"
    }
  ],
  "resources": [
    {
      "name": "lexicon",
      "methodName": "onLexicon",
      "url": "https://docs.aws.amazon.com/polly/latest/dg/managing-lexicons.html",
      "arn": "arn:${Partition}:polly:${Region}:${Account}:lexicon/${LexiconName}",
      "placeholders": [
        {
          "placeholder": "LexiconName",
          "name": "lexiconName",
          "kind": "required"
        },
        {
          "placeholder": "Account",
          "name": "account",
          "kind": "account"
        },
        {
          "placeholder": "Region",
          "name": "region",
          "kind": "region"
        },
        {
          "placeholder": "Partition",
          "name": "partition",
          "kind": "partition"
        }
      ],
      "conditionMethods": []
    }
  ],
  "conditions": []
}
