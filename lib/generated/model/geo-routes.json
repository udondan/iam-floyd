{
  "schemaVersion": 1,
  "filename": "geo-routes",
  "className": "GeoRoutes",
  "name": "geo-routes",
  "servicePrefix": "geo-routes",
  "url": "https://docs.aws.amazon.com/service-authorization/latest/reference/list_geo-routes.html",
  "accessLevelList": {
    "Read": [
      "CalculateIsolines",
      "CalculateRouteMatrix",
      "CalculateRoutes",
      "OptimizeWaypoints",
      "SnapToRoads"
    ]
  },
  "actions": [
    {
      "name": "CalculateIsolines",
      "methodName": "toCalculateIsolines",
      "description": "Grants permission to determine destinations or service areas reachable within a specified time",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/location/latest/APIReference/API_CalculateIsolines.html"
    },
    {
      "name": "CalculateRouteMatrix",
      "methodName": "toCalculateRouteMatrix",
      "description": "Grants permission to calculate routing matrice which providing travel time and distances between sets of origins and destinations",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/location/latest/APIReference/API_CalculateRouteMatrix.html"
    },
    {
      "name": "CalculateRoutes",
      "methodName": "toCalculateRoutes",
      "description": "Grants permission to calculates routes between two or more locations",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/location/latest/APIReference/API_CalculateRoutes.html"
    },
    {
      "name": "OptimizeWaypoints",
      "methodName": "toOptimizeWaypoints",
      "description": "Grants permission to calculate the most efficient sequence for visiting multiple waypoints or locations along a route",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/location/latest/APIReference/API_OptimizeWaypoints.html"
    },
    {
      "name": "SnapToRoads",
      "methodName": "toSnapToRoads",
      "description": "Grants permission to enhances the accuracy of geographic positioning by aligning GPS coordinates to the nearest road segments on a digital map",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/location/latest/APIReference/API_SnapToRoads.html"
    }
  ],
  "resources": [
    {
      "name": "provider",
      "methodName": "onProvider",
      "url": "https://docs.aws.amazon.com/location/latest/developerguide/Welcome.html",
      "arn": "arn:${Partition}:geo-routes:${Region}::provider/default",
      "placeholders": [
        {
          "placeholder": "Region",
          "name": "region",
          "kind": "region"
        },
        {
          "placeholder": "Partition",
          "name": "partition",
          "kind": "partition"
        }
      ],
      "conditionMethods": []
    }
  ],
  "conditions": []
}
