      "url": "https://docs.aws.amazon.com/msk/latest/developerguide/iam-access-control.html#actions"
    },
    {
      "name": "DescribeCluster",
      "methodName": "toDescribeCluster",
      "description": "Grants permission to describe various aspects of the cluster, equivalent to Apache Kafka's DESCRIBE CLUSTER ACL",
      "accessLevel": "List",
      "url": "https://docs.aws.amazon.com/msk/latest/developerguide/iam-access-control.html#actions"
    },
    {
      "name": "DescribeClusterDynamicConfiguration",
      "methodName": "toDescribeClusterDynamicConfiguration",
