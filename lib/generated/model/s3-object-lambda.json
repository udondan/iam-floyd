{
  "schemaVersion": 1,
  "filename": "s3-object-lambda",
  "className": "S3ObjectLambda",
  "name": "s3-object-lambda",
  "servicePrefix": "s3-object-lambda",
  "url": "https://docs.aws.amazon.com/service-authorization/latest/reference/list_s3-object-lambda.html",
  "accessLevelList": {
    "Write": [
      "AbortMultipartUpload",
      "DeleteObject",
      "DeleteObjectTagging",
      "DeleteObjectVersion",
      "DeleteObjectVersionTagging",
      "PutObject",
      "PutObjectAcl",
      "PutObjectLegalHold",
      "PutObjectRetention",
      "PutObjectTagging",
      "PutObjectVersionAcl",
      "PutObjectVersionTagging",
      "RestoreObject",
      "WriteGetObjectResponse"
    ],
    "Tagging": [
      "DeleteObjectTagging",
      "DeleteObjectVersionTagging",
      "PutObjectTagging",
      "PutObjectVersionTagging"
    ],
    "Read": [
      "GetObject",
      "GetObjectAcl",
      "GetObjectLegalHold",
      "GetObjectRetention",
      "GetObjectTagging",
      "GetObjectVersion",
      "GetObjectVersionAcl",
      "GetObjectVersionTagging"
    ],
    "List": [
      "ListBucket",
      "ListBucketMultipartUploads",
      "ListBucketVersions",
      "ListMultipartUploadParts"
    ],
