{
  "schemaVersion": 1,
  "filename": "sqs",
  "className": "Sqs",
  "name": "sqs",
  "servicePrefix": "sqs",
  "url": "https://docs.aws.amazon.com/service-authorization/latest/reference/list_sqs.html",
  "accessLevelList": {
    "Permissions management": [
      "AddPermission",
      "RemovePermission",
      "SetQueueAttributes"
    ],
    "Write": [
      "AddPermission",
      "CancelMessageMoveTask",
      "ChangeMessageVisibility",
      "CreateQueue",
      "DeleteMessage",
      "DeleteQueue",
      "PurgeQueue",
      "RemovePermission",
      "SendMessage",
      "SetQueueAttributes",
      "StartMessageMoveTask",
      "TagQueue",
      "UntagQueue"
    ],
    "Read": [
      "GetQueueAttributes",
      "GetQueueUrl",
      "ListDeadLetterSourceQueues",
      "ListMessageMoveTasks",
      "ListQueueTags",
      "ListQueues",
      "ReceiveMessage"
    ],
    "Tagging": [
      "TagQueue",
      "UntagQueue"
    ]
  },
  "actions": [
    {
      "name": "AddPermission",
      "methodName": "toAddPermission",
      "description": "Grants permission to a queue for a specific principal",
      "accessLevel": "Permissions management, Write",
      "url": "https://docs.aws.amazon.com/AWSSimpleQueueService/latest/APIReference/API_AddPermission.html"
    },
    {
      "name": "CancelMessageMoveTask",
      "methodName": "toCancelMessageMoveTask",
      "description": "Grants permission to cancel an in progress message move task",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/AWSSimpleQueueService/latest/APIReference/API_CancelMessageMoveTask.html"
    },
    {
      "name": "ChangeMessageVisibility",
      "methodName": "toChangeMessageVisibility",
      "description": "Grants permission to change the visibility timeout of a specified message in a queue to a new value",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/AWSSimpleQueueService/latest/APIReference/API_ChangeMessageVisibility.html"
    },
    {
      "name": "CreateQueue",
      "methodName": "toCreateQueue",
      "description": "Grants permission to create a new queue, or returns the URL of an existing one",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/AWSSimpleQueueService/latest/APIReference/API_CreateQueue.html"
    },
    {
      "name": "DeleteMessage",
      "methodName": "toDeleteMessage",
      "description": "Grants permission to delete the specified message from the specified queue",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/AWSSimpleQueueService/latest/APIReference/API_DeleteMessage.html"
    },
    {
      "name": "DeleteQueue",
      "methodName": "toDeleteQueue",
      "description": "Grants permission to delete the queue specified by the queue URL, regardless of whether the queue is empty",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/AWSSimpleQueueService/latest/APIReference/API_DeleteQueue.html"
    },
    {
      "name": "GetQueueAttributes",
      "methodName": "toGetQueueAttributes",
      "description": "Grants permission to get attributes for the specified queue",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/AWSSimpleQueueService/latest/APIReference/API_GetQueueAttributes.html"
    },
    {
      "name": "GetQueueUrl",
      "methodName": "toGetQueueUrl",
      "description": "Grants permission to return the URL of an existing queue",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/AWSSimpleQueueService/latest/APIReference/API_GetQueueUrl.html"
    },
    {
      "name": "ListDeadLetterSourceQueues",
      "methodName": "toListDeadLetterSourceQueues",
      "description": "Grants permission to return a list of your queues that have the RedrivePolicy queue attribute configured with a dead letter queue",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/AWSSimpleQueueService/latest/APIReference/API_ListDeadLetterSourceQueues.html"
    },
    {
      "name": "ListMessageMoveTasks",
      "methodName": "toListMessageMoveTasks",
      "description": "Grants permission to list message move tasks",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/AWSSimpleQueueService/latest/APIReference/API_ListMessageMoveTasks.html"
    },
    {
      "name": "ListQueueTags",
      "methodName": "toListQueueTags",
      "description": "Grants permission to list tags added to an SQS queue",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/AWSSimpleQueueService/latest/APIReference/API_ListQueueTags.html"
    },
    {
      "name": "ListQueues",
      "methodName": "toListQueues",
      "description": "Grants permission to return a list of your queues",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/AWSSimpleQueueService/latest/APIReference/API_ListQueues.html"
    },
    {
      "name": "PurgeQueue",
      "methodName": "toPurgeQueue",
      "description": "Grants permission to delete the messages in a queue specified by the queue URL",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/AWSSimpleQueueService/latest/APIReference/API_PurgeQueue.html"
    },
    {
      "name": "ReceiveMessage",
      "methodName": "toReceiveMessage",
      "description": "Grants permission to retrieve one or more messages, with a maximum limit of 10 messages, from the specified queue",
      "accessLevel": "Read",
      "url": "https://docs.aws.amazon.com/AWSSimpleQueueService/latest/APIReference/API_ReceiveMessage.html"
    },
    {
      "name": "RemovePermission",
      "methodName": "toRemovePermission",
      "description": "Grants permission to revoke any permissions in the queue policy that matches the specified Label parameter",
      "accessLevel": "Permissions management, Write",
      "url": "https://docs.aws.amazon.com/AWSSimpleQueueService/latest/APIReference/API_RemovePermission.html"
    },
    {
      "name": "SendMessage",
      "methodName": "toSendMessage",
      "description": "Grants permission to deliver a message to the specified queue",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/AWSSimpleQueueService/latest/APIReference/API_SendMessage.html"
    },
    {
      "name": "SetQueueAttributes",
      "methodName": "toSetQueueAttributes",
      "description": "Grants permission to set the value of one or more queue attributes",
      "accessLevel": "Permissions management, Write",
      "url": "https://docs.aws.amazon.com/AWSSimpleQueueService/latest/APIReference/API_SetQueueAttributes.html"
    },
    {
      "name": "StartMessageMoveTask",
      "methodName": "toStartMessageMoveTask",
      "description": "Grants permission to start a message move task",
      "accessLevel": "Write",
      "url": "https://docs.aws.amazon.com/AWSSimpleQueueService/latest/APIReference/API_StartMessageMoveTask.html"
    },
    {
      "name": "TagQueue",
      "methodName": "toTagQueue",
      "description": "Grants permission to add tags to the specified SQS queue",
      "accessLevel": "Tagging, Write",
      "url": "https://docs.aws.amazon.com/AWSSimpleQueueService/latest/APIReference/API_TagQueue.html"
    },
    {
      "name": "UntagQueue",
      "methodName": "toUntagQueue",
      "description": "Grants permission to remove tags from the specified SQS queue",
      "accessLevel": "Tagging, Write",
      "url": "https://docs.aws.amazon.com/AWSSimpleQueueService/latest/APIReference/API_UntagQueue.html"
    }
  ],
  "resources": [
    {
      "name": "queue",
      "methodName": "onQueue",
      "url": "https://docs.aws.amazon.com/AWSSimpleQueueService/latest/SQSDeveloperGuide/sqs-queue-types.html",
      "arn": "arn:${Partition}:sqs:${Region}:${Account}:${QueueName}",
      "placeholders": [
        {
          "placeholder": "QueueName",
          "name": "queueName",
          "kind": "required"
        },
        {
          "placeholder": "Account",
          "name": "account",
          "kind": "account"
        },
        {
          "placeholder": "Region",
          "name": "region",
          "kind": "region"
        },
        {
          "placeholder": "Partition",
          "name": "partition",
          "kind": "partition"
        }
      ],
      "conditionMethods": [
        "ifAwsResourceTag"
      ]
    }
  ],
  "conditions": [
