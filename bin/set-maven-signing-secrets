#!/bin/bash
# Sets the GitHub secrets that bin/publish-maven signs with: the signing subkey of the maintainer key
# (without the primary secret key) and a new random passphrase for that copy.
# Needs the maintainer key in ~/.gnupg, pinentry-mac and gh. Run it again to replace the secrets.
set -euo pipefail

KEY=51CFBD98480666F3F6A6C430D3490185B661EDB8
SUBKEY=119D50F67ACE0A338020B07FD16F730CEC600C24
REPO=udondan/iam-floyd

TMP=$(mktemp -d)
trap 'gpgconf --homedir "${TMP}" --kill gpg-agent; rm -rf "${TMP}"; pbcopy < /dev/null' EXIT
chmod 700 "${TMP}"
echo "pinentry-program $(command -v pinentry-mac)" > "${TMP}/gpg-agent.conf"

# Only the primary user ID and the signing subkey: GitHub secrets are limited to 48 KB, the photo alone has 42 KB
echo "1/4 Copying the subkey (a dialog may ask for YOUR passphrase)"
gpg --armor --export-options export-minimal --export-filter 'keep-uid=primary -t' \
  --export-filter "drop-subkey=fpr != ${SUBKEY}" --export-secret-subkeys "${SUBKEY}!" |
  gpg --homedir "${TMP}" --batch --quiet --import
GRIP=$(gpg --homedir "${TMP}" --with-colons --with-keygrip --list-secret-keys "${KEY}" |
  awk -F: -v fpr="${SUBKEY}" '$1 == "fpr" && $10 == fpr { found = 1; next } found && $1 == "grp" { print $10; exit }')

PASS=$(openssl rand -base64 32)
printf %s "${PASS}" | pbcopy
echo "2/4 Setting the CI passphrase. A dialog asks for:"
echo "    - YOUR passphrase"
echo "    - the new passphrase, twice: just paste it, it is in the clipboard"
# gpg --passwd would also try the primary key, which is not in this keyring
gpg-connect-agent --homedir "${TMP}" "PASSWD ${GRIP}" /bye | grep -q '^OK'
pbcopy < /dev/null

echo "3/4 Checking: sec# means the primary secret key is not included"
gpg --homedir "${TMP}" --list-secret-keys --keyid-format long | grep -E "^(sec|ssb)"
echo test > "${TMP}/test"
gpg --homedir "${TMP}" --batch --pinentry-mode loopback --passphrase "${PASS}" --detach-sign "${TMP}/test"
gpg --homedir "${TMP}" --verify "${TMP}/test.sig" "${TMP}/test" 2>&1 | grep "using RSA key"

echo "4/4 Storing the GitHub secrets"
gpg --homedir "${TMP}" --batch --pinentry-mode loopback --passphrase "${PASS}" --armor \
  --export-secret-subkeys "${SUBKEY}!" > "${TMP}/key.asc"
echo "    key: $(wc -c < "${TMP}/key.asc") bytes"
gh secret set MAVEN_GPG_PRIVATE_KEY -R "${REPO}" < "${TMP}/key.asc"
printf %s "${PASS}" | gh secret set MAVEN_GPG_PRIVATE_KEY_PASSPHRASE -R "${REPO}"
echo "Done"
