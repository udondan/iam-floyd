#!/usr/bin/env bash

# Prints a sorted, unique list of services, actions, resource types or condition keys from the
# service models.
#
# Usage: bin/model-list <services|actions|resources|conditions> [model dir]
#
# Line formats:
#   services:   <prefix>
#   actions:    <prefix>:<action>;<access level>
#   resources:  <prefix>:<resource type>
#   conditions: <prefix>:<condition key without prefix>

set -euo pipefail
export LC_ALL=C

KIND="${1:?Usage: bin/model-list <services|actions|resources|conditions> [model dir]}"
DIR="${2:-lib/generated/model}"

# shellcheck disable=SC2016 # $p is a jq variable
case "${KIND}" in
  services)
    filter='.servicePrefix'
    ;;
  actions)
    filter='.servicePrefix as $p | .actions[] | "\($p):\(.name);\(.accessLevel)"'
    ;;
  resources)
    filter='.servicePrefix as $p | .resources[] | "\($p):\(.name)"'
    ;;
  conditions)
    filter='.servicePrefix as $p | .conditions[] | "\($p):\(.key | split(":")[1])"'
    ;;
  *)
    echo "Unknown kind: ${KIND}" >&2
    exit 1
    ;;
esac

find "${DIR}" -maxdepth 1 -name '*.json' -print0 |
  xargs -0 jq -r "${filter}" |
  sort -u
