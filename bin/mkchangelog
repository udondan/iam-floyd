#!/usr/bin/env bash

# Prints the changes of the AWS managed policies and of the services, actions, resource types and
# condition keys between a git ref and the working tree as markdown. Prints nothing if there are
# no changes.
#
# Usage: bin/mkchangelog [ref, default: the latest tag]

set -euo pipefail
export LC_ALL=C

REF="${1:-$(git describe --tags --abbrev=0)}"

TMP=$(mktemp -d)
trap 'rm -rf "${TMP}"' EXIT

MANAGED_POLICIES="lib/generated/aws-managed-policies/iam-floyd.ts"

# Names of the AWS managed policies in a file of the AwsManagedPolicy class
function policyNames() {
  sed -n "s/^ *public static [A-Za-z0-9_]* = '\(.*\)';$/\1/p" "$1" |
    sed 's|.*/||' | sort -u
}

# Writes the lists of services, actions, resource types, condition keys and managed policies of a
# git ref (or of the working tree, if no ref is given) to the directory $1
function writeLists() {
  local out="$1"
  local ref="${2:-}"
  local modelDir="lib/generated/model"
  mkdir -p "${out}"

  if [[ -n "${ref}" ]]; then
    git show "${ref}:${MANAGED_POLICIES}" > "${out}/policies.ts"
    policyNames "${out}/policies.ts" > "${out}/policies"

    local src="${out}/src"
    mkdir -p "${src}"
    if git cat-file -e "${ref}:lib/generated/model" 2> /dev/null; then
      git archive "${ref}" lib/generated/model | tar -x -C "${src}"
      modelDir="${src}/lib/generated/model"
    else
      # releases before the service models were committed only have the stats folder
      git archive "${ref}" stats | tar -x -C "${src}"
      sort -u "${src}/stats/services" | sed "/^$/d" > "${out}/services"
      for kind in actions resources conditions; do
        find "${src}/stats/${kind}" -maxdepth 1 -type f -print0 |
          xargs -0 cat | sort -u | sed "/^$/d" > "${out}/${kind}"
      done
      return
    fi
  else
    policyNames "${MANAGED_POLICIES}" > "${out}/policies"
  fi

  for kind in services actions resources conditions; do
    bin/model-list "${kind}" "${modelDir}" > "${out}/${kind}"
  done
}

writeLists "${TMP}/before" "${REF}"
writeLists "${TMP}/after"

# Lines only in the new state
function added() {
  comm -13 "${TMP}/before/$1" "${TMP}/after/$1"
}

# Lines only in the old state
function removed() {
  comm -23 "${TMP}/before/$1" "${TMP}/after/$1"
}

function toList() {
  sed "s/^/- /g"
}

# Actions. An action with a changed access level is in both lists
added actions > "${TMP}/actions-added"
removed actions > "${TMP}/actions-removed"
sed "s/;.*//g" "${TMP}/actions-added" | sort -u > "${TMP}/actions-added-names"
sed "s/;.*//g" "${TMP}/actions-removed" | sort -u > "${TMP}/actions-removed-names"
updatedAccessLevels=$(
  comm -12 "${TMP}/actions-added-names" "${TMP}/actions-removed-names" |
    while read -r action; do
      before=$(awk -F';' -v a="${action}" '$1 == a { print $2 }' "${TMP}/actions-removed")
      after=$(awk -F';' -v a="${action}" '$1 == a { print $2 }' "${TMP}/actions-added")
      echo "- ${action}: ${before} -> ${after}"
    done
)

# The sections of a block are separated by an empty line, the blocks by a horizontal line
blockHasContent=false
outputHasContent=false

function section() {
  local title="$1"
  local content="$2"
  [[ -z "${content}" ]] && return
  if [[ "${blockHasContent}" = true ]]; then
    echo ""
  elif [[ "${outputHasContent}" = true ]]; then
    printf "\n---\n\n"
  fi
  printf "%s\n\n%s\n" "${title}" "${content}"
  blockHasContent=true
  outputHasContent=true
}

function endBlock() {
  blockHasContent=false
}

section ":warning: **Removed AWS managed policies:**" "$(removed policies | toList)"
section "**New AWS managed policies:**" "$(added policies | toList)"
endBlock

section ":warning: **Removed services:**" "$(removed services | toList)"
section ":warning: **Removed actions:**" "$(comm -13 "${TMP}/actions-added-names" "${TMP}/actions-removed-names" | toList)"
section ":warning: **Removed condition keys:**" "$(removed conditions | toList)"
section ":warning: **Removed resource types:**" "$(removed resources | toList)"
section "**New services:**" "$(added services | toList)"
section "**New actions:**" "$(comm -23 "${TMP}/actions-added-names" "${TMP}/actions-removed-names" | toList)"
section "**Updated action access level:**" "${updatedAccessLevels}"
section "**New resource types:**" "$(added resources | toList)"
section "**New condition keys:**" "$(added conditions | toList)"
endBlock
