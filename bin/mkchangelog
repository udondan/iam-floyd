#!/usr/bin/env bash

# These are only used for creating a changelog file manually. by default the version is taken form the VERSION file
VERSION=$1
BEFORE=$2

export LC_ALL=C

TMP=$(mktemp -d)
trap 'rm -rf "${TMP}"' EXIT

function getLastTag() {
  git describe --tags --abbrev=0
}

function getVersion() {
  if [[ -n "${VERSION}" ]]; then
    echo "${VERSION}"
  else
    echo "v$(cat VERSION)"
  fi
}

# Writes the lists of services, actions, resource types and condition keys of a git ref (or of
# the working tree, if no ref is given) to the directory $1
function writeLists() {
  local out="$1"
  local ref="${2:-}"
  local modelDir="lib/generated/model"
  mkdir -p "${out}"

  if [[ -n "${ref}" ]]; then
    local src="${out}/src"
    mkdir -p "${src}"
    if git cat-file -e "${ref}:lib/generated/model" 2> /dev/null; then
      git archive "${ref}" lib/generated/model | tar -x -C "${src}"
      modelDir="${src}/lib/generated/model"
    else
      # releases before the service models were committed only have the stats folder
      git archive "${ref}" stats | tar -x -C "${src}"
      sort -u "${src}/stats/services" > "${out}/services"
      for kind in actions resources conditions; do
        find "${src}/stats/${kind}" -maxdepth 1 -type f -print0 |
          xargs -0 cat | sort -u > "${out}/${kind}"
      done
      return
    fi
  fi

  for kind in services actions resources conditions; do
    bin/model-list "${kind}" "${modelDir}" > "${out}/${kind}"
  done
}

if [[ -n "${VERSION}" && -n "${BEFORE}" ]]; then
  writeLists "${TMP}/before" "${BEFORE}"
  writeLists "${TMP}/after" "${VERSION}"
else
  writeLists "${TMP}/before" "$(getLastTag)"
  writeLists "${TMP}/after"
fi

# Lines only in the new state
function added() {
  comm -13 "${TMP}/before/$1" "${TMP}/after/$1"
}

# Lines only in the old state
function removed() {
  comm -23 "${TMP}/before/$1" "${TMP}/after/$1"
}

function toList() {
  sed "s/^/- /g"
}

# Services
newServices=$(added services | toList)
removedServices=$(removed services | toList)

# Actions. An action with a changed access level is in both lists
added actions > "${TMP}/actions-added"
removed actions > "${TMP}/actions-removed"
sed "s/;.*//g" "${TMP}/actions-added" | sort -u > "${TMP}/actions-added-names"
sed "s/;.*//g" "${TMP}/actions-removed" | sort -u > "${TMP}/actions-removed-names"
newActions=$(comm -23 "${TMP}/actions-added-names" "${TMP}/actions-removed-names" | toList)
removedActions=$(comm -13 "${TMP}/actions-added-names" "${TMP}/actions-removed-names" | toList)
updatedAccessLevels=$(
  comm -12 "${TMP}/actions-added-names" "${TMP}/actions-removed-names" |
    while read -r action; do
      before=$(awk -F';' -v a="${action}" '$1 == a { print $2 }' "${TMP}/actions-removed")
      after=$(awk -F';' -v a="${action}" '$1 == a { print $2 }' "${TMP}/actions-added")
      echo "- ${action}: ${before} -> ${after}"
    done
)

# Resource types
newResourceTypes=$(added resources | toList)
removedResourceTypes=$(removed resources | toList)

# Conditions
newConditions=$(added conditions | toList)
removedConditions=$(removed conditions | toList)

file="CHANGELOG/$(getVersion).md"
hasContent=false

[[ -f "$file" ]] && printf "\n---\n" >> "$file" && hasContent=true
touch "${file}"


if [ -n "${removedServices}" ]; then
  [[ "${hasContent}" = true ]] && echo "" >> "$file"
  printf ":warning: **Removed services:**\n\n" >> "$file"
  echo "${removedServices}" >> "$file"
  hasContent=true
fi

if [ -n "${removedActions}" ]; then
  [[ "${hasContent}" = true ]] && echo "" >> "$file"
  printf ":warning: **Removed actions:**\n\n" >> "$file"
  echo "${removedActions}" >> "$file"
  hasContent=true
fi

if [ -n "${removedConditions}" ]; then
  [[ "${hasContent}" = true ]] && echo "" >> "$file"
  printf ":warning: **Removed condition keys:**\n\n" >> "$file"
  echo "${removedConditions}" >> "$file"
  hasContent=true
fi

if [ -n "${removedResourceTypes}" ]; then
  [[ "${hasContent}" = true ]] && echo "" >> "$file"
  printf ":warning: **Removed resource types:**\n\n" >> "$file"
  echo "${removedResourceTypes}" >> "$file"
  hasContent=true
fi

if [ "${newServices}" ]; then
  [[ "${hasContent}" = true ]] && echo "" >> "$file"
  printf "**New services:**\n\n" >> "$file"
  echo "${newServices}" >> "$file"
  hasContent=true
fi

if [ -n "${newActions}" ]; then
  [[ "${hasContent}" = true ]] && echo "" >> "$file"
  printf "**New actions:**\n\n" >> "$file"
  echo "${newActions}" >> "$file"
  hasContent=true
fi

if [ -n "${updatedAccessLevels}" ]; then
  [[ "${hasContent}" = true ]] && echo "" >> "$file"
  printf "**Updated action access level:**\n\n" >> "$file"
  echo "${updatedAccessLevels}" >> "$file"
  hasContent=true
fi

if [ -n "${newResourceTypes}" ]; then
  [[ "${hasContent}" = true ]] && echo "" >> "$file"
  printf "**New resource types:**\n\n" >> "$file"
  echo "${newResourceTypes}" >> "$file"
  hasContent=true
fi

if [ -n "${newConditions}" ]; then
  [[ "${hasContent}" = true ]] && echo "" >> "$file"
  printf "**New condition keys:**\n\n" >> "$file"
  echo "${newConditions}" >> "$file"
  hasContent=true
fi
