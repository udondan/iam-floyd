<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
  <!-- The examples are snippets for the docs, which the runners compile without a package -->
  <suppress checks="PackageDeclaration|OuterTypeFilename" files="[\\/]examples[\\/]"/>
  <suppress checks="PackageDeclaration" files="[\\/]Main\.java$"/>
</suppressions>
