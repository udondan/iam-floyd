{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["ec2:RunInstances", "ec2:CreateTags"],
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Name": [
            "it's",
            "say \"hi\"",
            "back\\slash",
            "tab\tnewline\n",
            "unicode ✓",
            "${aws:username}"
          ],
          "ec2:InstanceType": "t3.micro"
        },
        "ForAnyValue:StringLike": {
          "aws:TagKeys": ["team-*"]
        },
        "NumericLessThanEquals": {
          "ec2:VolumeSize": 100
        },
        "Bool": {
          "aws:SecureTransport": false
        },
        "Null": {
          "aws:TokenIssueTime": "true"
        },
        "IpAddress": {
          "aws:SourceIp": ["10.0.0.0/8", "192.168.0.0/16"]
        },
        "DateGreaterThan": {
          "aws:CurrentTime": "2020-01-01T00:00:00Z"
        }
      }
    }
  ]
}
