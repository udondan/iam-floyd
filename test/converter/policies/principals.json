{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Principal": {
        "AWS": [
          "arn:aws:iam::123456789012:root",
          "arn:aws:iam::123456789012:user/bob",
          "arn:aws:iam::123456789012:user/division/alice",
          "arn:aws:iam::123456789012:role/role-name",
          "arn:aws:sts::123456789012:assumed-role/role-name/session-name",
          "arn:aws-cn:iam::123456789012:root",
          "123456789012"
        ],
        "Service": ["lambda.amazonaws.com", "ec2.amazonaws.com"],
        "Federated": [
          "cognito-identity.amazonaws.com",
          "www.amazon.com",
          "accounts.google.com",
          "graph.facebook.com",
          "arn:aws:iam::123456789012:saml-provider/provider",
          "arn:aws:iam::123456789012:oidc-provider/example.com"
        ],
        "CanonicalUser": "79a59df900b949e55d96a1e698fbacedfd6e09d98eacf8f8d5218e7cd47ef2be"
      },
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "external-id"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::public-bucket/*",
      "Principal": "*"
    },
    {
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "NotPrincipal": {
        "AWS": "arn:aws:iam::123456789012:root"
      }
    }
  ]
}
