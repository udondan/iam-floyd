<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <!-- version ranges of the generated packages and advisories of their dependencies -->
    <NoWarn>NU1603;NU1608;NU1900;NU1901;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- from the local NuGet sources written by jsii-pacmak, configured by run.sh -->
    <PackageReference Include="Floyd.Consumer" Version="1.0.0" />
  </ItemGroup>
</Project>
