        "assurance:ListEvidenceAnnotations",
        "assurance:ListProjects",
        "assurance:ListTasks",
        "assurance:StartResourceDiscovery",
        "assurance:UpdateTask",
        "assurance:UploadEvidence"
      ],
      "Resource": "arn:*:assurance:*:*:environment/*"
